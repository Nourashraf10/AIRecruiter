# Example environment variables for the ai_recruiter posting module.
#
# NEVER commit real credentials. Copy this file to `.env` (or merge into your
# project-level .env) and fill in your own values locally.
#
# Facebook credentials for job posting automation
FACEBOOK_EMAIL=your_facebook_email@example.com
FACEBOOK_PASSWORD=your_facebook_password

# LinkedIn credentials for job posting automation
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# Whether Playwright should run in headless mode.
# Set to "false" while you are iterating on selectors so you can see the browser.
POSTING_HEADLESS=true

