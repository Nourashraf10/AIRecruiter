# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Timezone
TIME_ZONE=Africa/Cairo
CELERY_TIMEZONE=Africa/Cairo

# Database (Docker services)
POSTGRES_DB=ai_agent
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=your-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis/Celery
REDIS_URL=redis://redis:6379/0

# Email (SMTP)
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@domain.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
# Approval email subject; default is job title only to avoid SMTP policy blocks. Use {title} for vacancy title.
# APPROVAL_EMAIL_SUBJECT={title}

# CalDAV (Manager 1)
CALDAV_URL_1=https://calendar.zoho.com/caldav/your-calendar-id/events/
CALDAV_USERNAME_1=manager1@domain.com
CALDAV_PASSWORD_1=your-app-password

# CalDAV (Manager 2)
CALDAV_URL_2=https://calendar.zoho.com/caldav/your-calendar-id/events/
CALDAV_USERNAME_2=manager2@domain.com
CALDAV_PASSWORD_2=your-app-password

# Zoho Mail Monitor
ZOHO_EMAIL=monitor@domain.com
ZOHO_EMAIL_PASSWORD=your-app-password
# Set to 1 to also process read emails with "Open Vacancy" in subject
ZOHO_VACANCY_INCLUDE_READ=0

# Docker hint for mail monitor
DOCKER_CONTAINER=1

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Zoho OAuth Configuration
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REDIRECT_URI=http://localhost:8040/api/oauth/callback/

# Company Email Addresses
DEFAULT_MANAGER_EMAIL=manager@yourcompany.com
AI_RECRUITER_EMAIL=recruiter@yourcompany.com
APPLICATION_EMAIL=applications@yourcompany.com

# Posting: blue-collar departments post to Facebook only; others post to LinkedIn only (comma-separated)
BLUE_COLLAR_DEPARTMENTS=Office,Office Boy,Blue Collar

# LinkedIn Automation
LINKEDIN_EMAIL=your-linkedin-account@company.com
LINKEDIN_PASSWORD=your-linkedin-password
LINKEDIN_COMPANY_PAGE=https://www.linkedin.com/company/your-company
LINKEDIN_POSTING_ENABLED=True
LINKEDIN_HEADLESS=True

